{
  "name": "form-studio",
  "version": "0.27.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node server.mjs",
    "demo": "node server.mjs --demo-mode",
    "demo:reset": "node scripts/reset-demo-data.mjs",
    "test": "playwright test",
    "test:contract": "playwright test tests/contract",
    "test:runtime": "playwright test tests/runtime",
    "test:e2e": "playwright test tests/e2e",
    "visual:local": "node scripts/capture-local-visual-evidence.mjs",
    "check:structure": "node scripts/check-structure.mjs",
    "check": "npm run check:structure && npm test"
  },
  "dependencies": {
    "linkedom": "^0.18.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "ajv": "^8.20.0"
  }
}
