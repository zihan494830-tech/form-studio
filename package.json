{
  "name": "form-studio",
  "version": "1.0.0-alpha.1",
  "description": "Local-first Agent form authoring, publishing, submission, and inbox workbench.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "scripts": {
    "start": "node server.mjs",
    "demo": "node server.mjs --demo-mode",
    "demo:reset": "node scripts/reset-demo-data.mjs",
    "data:migrate": "node scripts/migrate-form-studio-data.mjs",
    "test": "playwright test",
    "test:contract": "playwright test tests/contract",
    "test:runtime": "playwright test tests/runtime",
    "test:e2e": "playwright test tests/e2e",
    "visual:local": "node scripts/capture-local-visual-evidence.mjs",
    "check:structure": "node scripts/check-structure.mjs",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check": "npm run check:structure && npm run check:syntax && npm test"
  },
  "dependencies": {
    "linkedom": "^0.18.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
