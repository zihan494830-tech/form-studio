# 仅允许 127.0.0.1 或 0.0.0.0；默认 127.0.0.1。
FORM_STUDIO_HOST=127.0.0.1

# HTTP 监听端口；默认 4190。
FORM_STUDIO_PORT=4190

# SQLite 路径；留空时使用仓库 data/form-studio.sqlite。
FORM_STUDIO_DB_PATH=

# 只允许 product、demo 或 test；默认 product。
FORM_STUDIO_MODE=product

# 只允许 true 或 false；仅在直连端口受限且可信代理覆盖 forwarded headers 时开启。
FORM_STUDIO_TRUST_PROXY=false

# 可选的公开 http(s) origin；不得包含路径、查询、片段或凭据。
FORM_STUDIO_PUBLIC_ORIGIN=

# 可选的部署源码/镜像指纹，仅用于健康检查与诊断。
FORM_STUDIO_RUNTIME_REVISION=development
