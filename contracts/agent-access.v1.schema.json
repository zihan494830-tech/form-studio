{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-access/v1",
  "title": "Form Studio agent access v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "tenantId", "classId", "authorIds", "teacherIds"],
  "properties": {
    "version": { "const": "agent-access/v1" },
    "tenantId": { "type": "string", "minLength": 1 },
    "classId": { "type": "string", "minLength": 1 },
    "authorIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "teacherIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  }
}
