{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "form-ledger/v1",
  "title": "form-ledger/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "ownerAgent", "formVersion", "status", "fields", "submit"],
  "properties": {
    "version": { "const": "form-ledger/v1" },
    "ownerAgent": { "type": "string", "minLength": 1 },
    "formVersion": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["draft", "published"] },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "control", "required"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
          "label": { "type": "string", "minLength": 1 },
          "control": { "enum": ["text", "textarea", "number", "select", "checkbox"] },
          "required": { "type": "boolean" },
          "options": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "submit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "to"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "to": { "const": "agent-input" }
      }
    }
  }
}
